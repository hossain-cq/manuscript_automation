# Copy to .env and fill in. Never commit the real .env file.

# Required — model_gateway.get_openai_client() raises at call time if unset.
OPENAI_API_KEY=

# Optional — point at a self-hosted / OpenAI-compatible endpoint instead of
# the public API (e.g. a local vLLM/Ollama server, or a free-tier provider
# like Groq: https://api.groq.com/openai/v1).
# OPENAI_API_BASE=http://localhost:11434/v1

# Per-role model overrides read directly by graphs/subgraphs/*.py. Defaults
# are OpenAI model IDs (gpt-5 / gpt-5-mini) and won't resolve against a
# different OPENAI_API_BASE — set these to match whatever provider you're
# using. Verified working against Groq's free tier with openai/gpt-oss-120b.
# ASSESSMENT_MODEL=openai/gpt-oss-120b
# NOVELTY_MODEL=openai/gpt-oss-120b
# LITERATURE_MODEL=openai/gpt-oss-120b
# REVIEW_MODEL=openai/gpt-oss-120b
# REVISION_MODEL=openai/gpt-oss-120b
# DRAFTING_MODEL=openai/gpt-oss-120b

# Optional overrides — defaults match configs/app.yaml.
# DATABASE_PATH=./projects/managed/manuscript_system.sqlite
# CHECKPOINT_PATH=./projects/managed/checkpoints.sqlite
# ARTIFACT_STORE_PATH=./projects/managed/artifacts
